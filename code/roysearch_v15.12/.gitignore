# ── Inputs the estimation does NOT need ──────────────────────────────────────
# Raw survey extracts (77 GB) and the intermediate Arrow tables are inputs to the
# data pipeline, not to the estimation: smm_main.jl and MCMC_main.jl read only the
# small CSV/JSON products below (80 KB for all four windows).
/data/raw/
/data/derived/*.arrow

# Reference material and typeset output — not code, not inputs.
/extra documents/
/literature/
/latex/
literature.zip

# ── Build and editor artefacts ───────────────────────────────────────────────
*.jl.cov
*.jl.*.cov
*.jl.mem
.DS_Store
.ipynb_checkpoints/

# ── Run outputs ──────────────────────────────────────────────────────────────
# Logs and figures are regenerated by a run and would otherwise churn the history.
/output/logs/
/output/figures/
/output/tables/
*.jld2

# Serialised bundles: the estimation optimum IS a shipped input (a warmstart seeds
# from it, and a reader reproduces the reported run rather than a fresh search), so
# smm_result_* is tracked deliberately.  MCMC chains are large and reproducible
# from the bundle, so they are not.
/output/smm/mcmc_chain_*.jls
/output/smm/candidates_*.jls
!/output/smm/smm_result_*.jls

# ── Superseded snapshots ─────────────────────────────────────────────────────
# Version history belongs in git, not in dated copies of the tree beside it.
/code/roysearch_v*/
/code/roysearch_v*.zip
/code/notebooks/

# Julia's own environments elsewhere in the tree; the pinned root pair is tracked.
**/JuliaProject.toml
