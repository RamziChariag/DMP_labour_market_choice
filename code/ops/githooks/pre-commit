#!/usr/bin/env bash
# Keeps files over 100 MB out of git. A .gitignore pattern cannot test a file's size, so the
# test runs here, at every commit: each staged file over the limit is taken out of the index
# (the copy on disk is untouched) and its path is added to .gitignore, so later commits leave
# it out as well. The commit then goes ahead with everything else. GitHub refuses files over
# 100 MiB; the limit here is 100 MB.
#
# Activate once in every clone (this machine and each VM), from the repository root:
#     git config core.hooksPath code/ops/githooks

limit=100000000
cd "$(git rev-parse --show-toplevel)" || exit 1

out=()
while IFS= read -r -d '' f; do
    size=$(git cat-file -s ":$f" 2>/dev/null) || continue
    if [ "$size" -gt "$limit" ]; then
        git rm --cached --quiet -- "$f" || exit 1
        out+=("$f")
        printf 'pre-commit: %s is %d MB, over the 100 MB limit: left out of git and added to .gitignore\n' \
            "$f" "$((size / 1000000))" >&2
    fi
done < <(git diff --cached --name-only --diff-filter=ACMRT -z)

[ "${#out[@]}" -eq 0 ] && exit 0

header='# Files over 100 MB, added by code/ops/githooks/pre-commit'
grep -qxF -- "$header" .gitignore 2>/dev/null || printf '\n%s\n' "$header" >> .gitignore
for f in "${out[@]}"; do
    pat="/$(printf '%s' "$f" | sed 's/[][*?\\]/\\&/g; s/ $/\\ /')"
    grep -qxF -- "$pat" .gitignore || printf '%s\n' "$pat" >> .gitignore
done
git add .gitignore
exit 0
